# Public origin this site is served from. Used for canonical links,
# robots.txt and the sitemap. Safe to expose — it is the address visitors
# already type. Falls back to the Vercel production host, then localhost.
NEXT_PUBLIC_SITE_URL=

# Contentful — server-side only. These are intentionally not prefixed with
# NEXT_PUBLIC_, so the delivery token is never bundled into client JavaScript.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=

# Optional. Only needed to render unpublished entries in draft previews.
# CONTENTFUL_PREVIEW_TOKEN=

# Shared secret for the Contentful publish webhook at /api/revalidate.
# Must match the x-contentful-webhook-secret header configured in Contentful.
CONTENTFUL_REVALIDATE_SECRET=

# Content Management token. Required only by the contact form endpoint,
# which records submissions as Contentful entries. Page rendering does not use it.
CONTENTFUL_MANAGEMENT_TOKEN=
